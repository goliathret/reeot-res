#include <winver.h>

1 ICON "@REEOT_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Spider-Man: Edge of Time, recompiled"
      VALUE "FileVersion",     "@PROJECT_VERSION@"
      VALUE "InternalName",    "EdgeOfTimeRecomp"
      VALUE "OriginalFilename", "EdgeOfTimeRecomp.exe"
      VALUE "ProductName",     "EdgeOfTimeRecomp"
      VALUE "ProductVersion",  "@PROJECT_VERSION@"
      VALUE "BuildStamp",      "@REEOT_BUILD_TIMESTAMP@"
      VALUE "Commit",          "@REEOT_GIT_COMMIT@"
      VALUE "Modified",        "@REEOT_GIT_DIRTY@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
